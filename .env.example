# Supabase > Project Settings > Data API / API Keys
# Only a publishable key belongs in this browser application. Never use a secret/service_role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional. GitHub Pages workflow sets this to /money/ automatically.
# VITE_BASE_PATH=/
